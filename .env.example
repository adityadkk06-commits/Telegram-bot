# ── Required ─────────────────────────────────────────────────────────────────
# Your Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=your_bot_token_here

# ── Optional (used by run_daily_open.py / run_scan.py standalone scripts) ───
# Your Telegram chat or group ID (get via @userinfobot)
TELEGRAM_CHAT_ID=your_chat_id_here
